<Window x:Class="MidiaScraper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MídiaScraper" Height="680" Width="860"
        MinHeight="620" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ShowInTaskbar="True"
        Background="#0F0F13"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7C3AED" Offset="0"/>
            <GradientStop Color="#4F46E5" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GreenGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#059669" Offset="0"/>
            <GradientStop Color="#10B981" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RedGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#DC2626" Offset="0"/>
            <GradientStop Color="#EF4444" Offset="1"/>
        </LinearGradientBrush>

        <!-- TextBox Style (sem ControlTemplate para garantir visibilidade do texto) -->
        <Style x:Key="UrlInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="CaretBrush" Value="#A78BFA"/>
            <Setter Property="SelectionBrush" Value="#7C3AED"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Border style wrapping the TextBox -->
        <Style x:Key="UrlBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="BorderBrush" Value="#2D2D42"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="28,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#7C3AED" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="Foreground" Value="#A78BFA"/>
            <Setter Property="BorderBrush" Value="#2D2D42"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22223A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#7C3AED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2D2D42"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Log TextBox Style -->
        <Style x:Key="LogStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A10"/>
            <Setter Property="Foreground" Value="#7DD3FC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- Card Border Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#16161F"/>
            <Setter Property="BorderBrush" Value="#2D2D42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <!-- CheckBox Style -->
        <Style x:Key="DarkCheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <!-- Background glow -->
        <Ellipse Width="500" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-100,-80,0,0" Opacity="0.04">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#7C3AED" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="400" Height="250" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-80,-60" Opacity="0.03">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4F46E5" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7C3AED" Offset="0"/>
                            <GradientStop Color="#4F46E5" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="▼" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontWeight="Bold"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="MídiaScraper" FontSize="24" FontWeight="Bold" Foreground="#F1F5F9"/>
                    <TextBlock Text="Download de vídeos do YouTube, Twitter e muito mais" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Status Badge -->
                <Border x:Name="StatusBadge" CornerRadius="20" Padding="12,4" Margin="20,0,0,0"
                        VerticalAlignment="Center" Background="#1A1A24" BorderBrush="#2D2D42" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"
                                 AutomationProperties.Name="Status: Pronto">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.2" Duration="0:0:1"
                                                             AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock x:Name="StatusText" Text="Pronto" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- URL Input Card -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="URL DO VÍDEO" FontSize="10" FontWeight="Bold"
                               Foreground="#94A3B8"/>

                    <!-- URL Input Row -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- URL TextBox wrapped in Border for rounded corners -->
                        <Border Grid.Column="0" Height="50"
                                Style="{StaticResource UrlBorderStyle}"
                                x:Name="UrlBorder">
                            <Border.Triggers>
                                <!-- Focus visual handled in code-behind -->
                            </Border.Triggers>
                            <TextBox x:Name="UrlTextBox"
                                     Style="{StaticResource UrlInputStyle}"
                                     Text=""
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     PreviewKeyDown="UrlTextBox_PreviewKeyDown"
                                     GotFocus="UrlTextBox_GotFocus"
                                     LostFocus="UrlTextBox_LostFocus"
                                     AutomationProperties.Name="URL do vídeo — cole uma ou várias, uma por linha"/>
                        </Border>
                        <!-- Placeholder via Adorner workaround using overlayed TextBlock -->

                        <Button x:Name="PasteButton"
                                Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="50" Width="100"
                                Click="PasteButton_Click"
                                AutomationProperties.Name="Colar URL da área de transferência">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Colar" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="RecentUrlsButton"
                                Grid.Column="4"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="50" Width="50"
                                Click="RecentUrlsButton_Click"
                                AutomationProperties.Name="Ver URLs recentes"
                                ToolTip="URLs recentes">
                            <TextBlock Text="🕘" FontSize="16"/>
                        </Button>

                        <Popup x:Name="RecentUrlsPopup" PlacementTarget="{Binding ElementName=RecentUrlsButton}"
                               Placement="Bottom" StaysOpen="False">
                            <Border Background="#16161F" BorderBrush="#2D2D42" BorderThickness="1"
                                    CornerRadius="8" Padding="6" MaxWidth="480" MinWidth="200">
                                <ItemsControl x:Name="RecentUrlsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Click="RecentUrlItem_Click"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="#E2E8F0" HorizontalContentAlignment="Left"
                                                    Padding="10,7" Cursor="Hand" FontSize="12">
                                                <Button.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>

                        <Button x:Name="DownloadButton"
                                Grid.Column="6"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="50" Width="140"
                                Click="DownloadButton_Click"
                                AutomationProperties.Name="Iniciar ou parar o download">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DownloadIcon" Text="⬇" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock x:Name="DownloadButtonText" Text="Baixar" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Options Row -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Formato:" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="FormatCombo" Width="130" Height="36"
                                      Style="{StaticResource DarkComboStyle}"
                                      SelectionChanged="FormatCombo_SelectionChanged">
                                <ComboBoxItem Content="Melhor qualidade" IsSelected="True" Tag="best"/>
                                <ComboBoxItem Content="1080p" Tag="1080"/>
                                <ComboBoxItem Content="720p" Tag="720"/>
                                <ComboBoxItem Content="480p" Tag="480"/>
                                <ComboBoxItem Content="Somente áudio (MP3)" Tag="audio"/>
                            </ComboBox>
                        </StackPanel>

                        <CheckBox x:Name="SubtitleCheck" Grid.Column="2"
                                  Style="{StaticResource DarkCheckStyle}"
                                  Content="Baixar legendas"/>

                        <CheckBox x:Name="PlaylistCheck" Grid.Column="4"
                                  Style="{StaticResource DarkCheckStyle}"
                                  Content="Baixar playlist inteira"/>

                        <Button x:Name="FolderButton" Grid.Column="6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="36" Padding="14,8"
                                Click="FolderButton_Click"
                                AutomationProperties.Name="Escolher pasta de destino">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock x:Name="FolderButtonText" Text="Pasta de saída" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Progress Section / Empty State (mutuamente exclusivos) -->
            <Grid Grid.Row="4">
                <Border x:Name="EmptyStateCard" Style="{StaticResource CardStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🔗" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cole uma URL acima e clique em Baixar para começar"
                                   Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ProgressCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Metadata Preview (só aparece quando conseguimos obter dados do vídeo) -->
                        <Grid x:Name="MetadataPreviewPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="96" Height="54" CornerRadius="6"
                                    Background="#1A1A24" ClipToBounds="True">
                                <Image x:Name="MetadataThumbnail" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="MetadataTitle" Text="" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MetadataDuration" Text="" FontSize="12"
                                           Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PROGRESSO" FontSize="10" FontWeight="Bold"
                                       Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProgressPercent" Grid.Column="1"
                                       Text="0%" FontSize="13" FontWeight="Bold" Foreground="#7C3AED"/>
                        </Grid>

                        <!-- Progress Bar -->
                        <Border Grid.Row="3" Height="8" Background="#1A1A24" CornerRadius="4">
                            <Border x:Name="ProgressFill" HorizontalAlignment="Left" CornerRadius="4"
                                    Width="0" Height="8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#7C3AED" Offset="0"/>
                                        <GradientStop Color="#06B6D4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>

                        <Grid Grid.Row="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProgressStatus" Grid.Column="0"
                                       Text="Aguardando URL..." Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock x:Name="ProgressEta" Grid.Column="1"
                                       Text="" Foreground="#94A3B8" FontSize="12" Margin="12,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Playlist Selection -->
                <Border x:Name="PlaylistSelectionCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="PlaylistTitleText" Grid.Row="0" Text="Playlist encontrada"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button x:Name="SelectAllButton" Content="Selecionar todos"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="32" Padding="12,6" FontSize="12" Margin="0,0,10,0"
                                    Click="SelectAllButton_Click"/>
                            <Button x:Name="SelectNoneButton" Content="Selecionar nenhum"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="32" Padding="12,6" FontSize="12"
                                    Click="SelectNoneButton_Click"/>
                        </StackPanel>

                        <Border Grid.Row="4" Background="#1A1A24" CornerRadius="8"
                                BorderBrush="#2D2D42" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PlaylistItemsControl" Margin="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Style="{StaticResource DarkCheckStyle}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                           Foreground="#E2E8F0" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Status}"
                                                           Foreground="#94A3B8" FontSize="11"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Button x:Name="DownloadSelectedButton" Grid.Row="6"
                                Style="{StaticResource PrimaryButtonStyle}" Height="44" Padding="20,10"
                                HorizontalAlignment="Right" Click="DownloadSelectedButton_Click">
                            <TextBlock Text="Baixar selecionados"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- History -->
                <Border x:Name="HistoryCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HISTÓRICO" FontSize="10" FontWeight="Bold"
                                       Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="CloseHistoryButton"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#94A3B8" FontSize="12" Cursor="Hand" Padding="8,4"
                                    Click="CloseHistoryButton_Click"
                                    AutomationProperties.Name="Fechar histórico">
                                <TextBlock Text="✕"/>
                            </Button>
                        </Grid>

                        <Border Grid.Row="2" Background="#1A1A24" CornerRadius="8"
                                BorderBrush="#2D2D42" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="HistoryItemsControl" Margin="4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" Foreground="#E2E8F0"
                                                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CompletedAtDisplay}"
                                                               Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Status}"
                                                           Foreground="#94A3B8" FontSize="11"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Error Banner -->
            <Border x:Name="ErrorBanner" Grid.Row="5" Visibility="Collapsed" Margin="0,16,0,0"
                    Background="#2A1414" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="12" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ErrorBannerText" Grid.Column="1" Text=""
                               Foreground="#FCA5A5" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button x:Name="ErrorBannerCloseButton" Grid.Column="2"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#FCA5A5" FontSize="13" Cursor="Hand" Padding="8,4"
                            Click="ErrorBannerCloseButton_Click"
                            AutomationProperties.Name="Fechar aviso de erro">
                        <TextBlock Text="✕"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Log Output -->
            <Border Grid.Row="7" Background="#0A0A10" BorderBrush="#1E1E2E" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#16161F" CornerRadius="12,12,0,0" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0"/>
                                <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,6,0"/>
                                <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,14,0"/>
                                <TextBlock Text="Console" Foreground="#94A3B8" FontSize="12"
                                           FontFamily="Consolas" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="ClearLogButton"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#94A3B8" FontSize="11" Cursor="Hand"
                                    Click="ClearLogButton_Click" Padding="8,4"
                                    AutomationProperties.Name="Limpar console de log">
                                <TextBlock Text="Limpar"/>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBox Grid.Row="1" x:Name="LogTextBox" Style="{StaticResource LogStyle}"/>
                </Grid>
            </Border>

            <!-- Footer / Download List -->
            <Border Grid.Row="9" Style="{StaticResource CardStyle}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="DownloadCountText" Text="0 downloads concluídos"
                                   Foreground="#94A3B8" FontSize="12"/>
                        <TextBlock Text=" · " Foreground="#2D2D42" FontSize="12"/>
                        <TextBlock x:Name="OutputFolderText" Text="Pasta: padrão do sistema"
                                   Foreground="#94A3B8" FontSize="12"/>
                    </StackPanel>

                    <Button x:Name="StopButton"
                            Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="36" Padding="16,8"
                            IsEnabled="False"
                            Click="StopButton_Click"
                            AutomationProperties.Name="Parar download em andamento">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏹" Margin="0,0,6,0"/>
                            <TextBlock Text="Parar"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="OpenFolderButton"
                            Grid.Column="3"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="36" Padding="16,8"
                            Click="OpenFolderButton_Click"
                            AutomationProperties.Name="Abrir pasta de downloads no Explorer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" Margin="0,0,6,0"/>
                            <TextBlock Text="Abrir pasta"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="HistoryButton"
                            Grid.Column="5"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="36" Padding="16,8"
                            Click="HistoryButton_Click"
                            AutomationProperties.Name="Ver histórico de downloads">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕘" Margin="0,0,6,0"/>
                            <TextBlock Text="Histórico"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
